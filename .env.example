# The CLI reads process environment variables; it does not automatically load this file.
TYPESAFE_API_KEY=
TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-latest
# Set actual contracted prices to enable cost reporting; omitted prices remain unknown.
# TYPESAFE_INPUT_PER_MILLION=
# TYPESAFE_OUTPUT_PER_MILLION=

# Autoresearch analyst: Codex CLI with ChatGPT login (gpt-6-astra, high), no API key.
# LongSeq brain: DeepSeek API by default; existing TEXT_MODEL_* settings are supported.
# Explicit PLANNER_* values take precedence over TEXT_MODEL_* defaults.
PLANNER_API_KEY=
PLANNER_ENDPOINT=
PLANNER_MODEL=
# PLANNER_INPUT_PER_MILLION=
# PLANNER_OUTPUT_PER_MILLION=

# Generative local-policy baseline (can use a different model).
POLICY_API_KEY=
POLICY_ENDPOINT=
POLICY_MODEL=
# POLICY_INPUT_PER_MILLION=
# POLICY_OUTPUT_PER_MILLION=

# Optional public BrowserGym / WebArena websites (actual deployed origins).
# WA_SHOPPING=
# WA_SHOPPING_ADMIN=
# WA_REDDIT=
# WA_GITLAB=
# WA_WIKIPEDIA=
# WA_MAP=
# WA_HOMEPAGE=

# Optional HTTP timeouts. Planner defaults to 90s, Jev to 30s.
# PLANNER_TIMEOUT_SECONDS=90
# TYPESAFE_TIMEOUT_SECONDS=30

# Context windows (tokens); DeepSeek official endpoint defaults to 1M.
# DS_CONTEXT_MAX_TOKENS=1000000
# JEV_CONTEXT_MAX_TOKENS=48000
# Jev also enforces the provider's 32k state + longest question limit.
# Optional per-role token overrides: POLICY_CONTEXT_MAX_TOKENS,
# BRAIN_CONTEXT_MAX_TOKENS, BRAIN_FINISH_CONTEXT_MAX_TOKENS.
# CONTEXT_OUTPUT_RESERVE_TOKENS=16384
# DEEPSEEK_TOKENIZER_PATH=/path/to/official/deepseek-v4.json
# Run scripts/install_context_tokenizers.py on macmini after dependency install.
# In token mode legacy *_CONTEXT_MAX_BYTES are compression soft targets only.
